<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is light only, so there is no values-night variant.

         Theme applied to the Android Window while the process is starting.
         It shows the launch screen until the Flutter engine draws its first
         frame. Android 12+ uses values-v31 instead. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has
         started: the color behind the Flutter UI while it initializes and
         runs. Cream, like the app. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
